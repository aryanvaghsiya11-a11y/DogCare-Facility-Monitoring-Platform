# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development    # development | staging | production

# --- Backend ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/alerts

# --- Auth ---------------------------------------------------------------------
# Cookie name used by the backend to set the auth cookie (httpOnly).
AUTH_COOKIE_NAME=dcare_session
# Roles permitted to use this build. Comma-separated.
ALLOWED_ROLES=staff,owner,manager

# --- Sentry -------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_PROJECT=dogcare-dashboard
SENTRY_ORG=

# --- Real-time ----------------------------------------------------------------
# Maximum number of buffered WS messages held before forcing a flush.
NEXT_PUBLIC_WS_BUFFER_MAX=200
# Reconnect backoff ceiling in ms.
NEXT_PUBLIC_WS_BACKOFF_MAX_MS=30000

# --- Media / clips ------------------------------------------------------------
# Single origin allowed to be embedded in iframes (incident video clips).
NEXT_PUBLIC_CLIP_EMBED_ORIGIN=https://clips.example.com

# --- Feature flags ------------------------------------------------------------
# Example: ENABLE_NEW_ALERT_LAYOUT=false
